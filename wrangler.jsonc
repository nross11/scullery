{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scullery",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "scullery", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "scullery-photos" }],
  "vars": {
    "GOOGLE_CLIENT_ID": "REPLACE_WITH_GOOGLE_CLIENT_ID"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`), kept out of the repo:
  //   GOOGLE_CLIENT_SECRET
  //   ALLOWED_EMAILS  e.g. you@gmail.com,partner@gmail.com
}
